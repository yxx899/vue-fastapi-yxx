# MySQL（需求文档默认）
DATABASE_URL=mysql+pymysql://kb:kb123456@localhost:3306/knowledge_base?charset=utf8mb4

# PostgreSQL（小P 可选）
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_base

SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 通义千问 DashScope
# 方式 A：API 快速接入弹窗里的 sk-ws- 密钥 + 工作空间
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE=ws-xxxx
DASHSCOPE_REGION=cn-beijing
# 可选专属网关（与弹窗「DashScope 地址」一致）
# DASHSCOPE_BASE_URL=https://ws-xxxx.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_MODEL=qwen-plus

# BGE 嵌入（本地 sentence-transformers）
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MOCK=false

CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5
